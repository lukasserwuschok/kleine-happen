<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!--
		allowBackup: Android may include the diary in the user's own Google device backup
		(only if the user turned that on). The developer never receives this data.
	-->
	<application android:allowBackup="true"
	             android:icon="@mipmap/appicon"
	             android:roundIcon="@mipmap/appicon_round"
	             android:supportsRtl="true"
	             android:label="@string/app_name"></application>

	<!--
		INTERNET: the built-in WebView serves the bundled interface through an https:// address,
		and the app downloads the public list of new recipes (rezepte.json) from GitHub Pages.
		No user data is ever sent.
	-->
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Optional photo of a meal or milestone, stored only on the phone. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<!-- Allergen reminders (Android 13+ asks the user first) and re-planning them after a restart. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

	<!-- Needed on Android 11+ so "Datenschutzerklärung" can open the browser. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="https" />
		</intent>
		<!-- Needed so "Kamera" can open the camera app. -->
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>
